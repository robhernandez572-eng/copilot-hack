<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1565C0"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tap any block to edit its hex bytes"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center_vertical"
            android:fontFamily="monospace"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴 = Sector Trailer"
            android:textColor="#FFCC80"
            android:textSize="11sp"/>

    </LinearLayout>

    <!-- Column headers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#E3F2FD"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:text="Block"
            android:textColor="#0D47A1"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textAllCaps="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hex (00 11 22 ...)"
            android:textColor="#0D47A1"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textAllCaps="true"/>

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="ASCII"
            android:textColor="#0D47A1"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textAllCaps="true"/>

    </LinearLayout>

    <!-- Block list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHexBlocks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"/>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <Button
            android:id="@+id/btnHexDiscard"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Discard"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <Button
            android:id="@+id/btnHexSave"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:layout_marginStart="6dp"
            android:text="Save Changes"
            android:backgroundTint="#388E3C"/>

    </LinearLayout>

</LinearLayout>
